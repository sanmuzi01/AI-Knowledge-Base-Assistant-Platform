# 统一行尾为 LF，避免 Windows autocrlf 造成整文件 diff。
# 一次性规范化：提交完当前改动后单独跑 `git add --renormalize . && git commit -m "chore: normalize line endings"`
* text=auto eol=lf

*.py    text eol=lf
*.pyi   text eol=lf
*.ts    text eol=lf
*.tsx   text eol=lf
*.js    text eol=lf
*.vue   text eol=lf
*.json  text eol=lf
*.md    text eol=lf
*.yml   text eol=lf
*.yaml  text eol=lf
*.html  text eol=lf
*.css   text eol=lf
*.sql   text eol=lf
*.sh    text eol=lf
*.cfg   text eol=lf
*.toml  text eol=lf
*.env   text eol=lf
.env.*  text eol=lf

# 二进制：不做行尾/编码处理
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.ico   binary
*.pdf   binary
*.zip   binary
*.woff  binary
*.woff2 binary
*.ttf   binary
