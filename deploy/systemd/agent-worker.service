[Unit]
Description=Agent Platform - background task worker
After=network.target agent-chroma.service
Wants=agent-chroma.service

[Service]
Type=simple
User=deploy
Group=deploy
WorkingDirectory=/srv/agent-app
EnvironmentFile=/srv/agent-app/.env
ExecStart=/srv/agent-app/.venv/bin/python -m service.background_worker
Restart=always
RestartSec=5
StandardOutput=append:/srv/agent-app/logs/worker.log
StandardError=append:/srv/agent-app/logs/worker.log

[Install]
WantedBy=multi-user.target
