APP_ENV=development

DB_USER=root
DB_PASSWORD=agent-platform-local-password
DB_HOST=mysql
DB_PORT=3306
DB_NAME=agent_sql
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800
DB_POOL_PRE_PING=true

MYSQL_PORT=3306
REDIS_PORT=6379
API_PORT=8000
FRONTEND_PORT=8080
API_WORKERS=1
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=agent-platform-grafana-password
ADMIN_USERNAME=admin
# 本地/开发环境可以留空，未配置时会自动生成随机密码并打印在启动日志里。
ADMIN_PASSWORD=
ADMIN_PASSWORD_RESET=false

TRUSTED_HOSTS=localhost,127.0.0.1,api,frontend
CORS_ALLOW_ORIGINS=http://localhost:8080,http://127.0.0.1:8080
MAX_REQUEST_BODY_BYTES=52428800
ENABLE_HSTS=0

JWT_SECRET_KEY=local-docker-dev-secret-change-before-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60

LLM_ENCRYPTION_KEY=SjwtgOMBtvnxyl5SJBWW7a2cVD-ou_AXDrsQ3CGmCQc=

EMBEDDING_PROVIDER=zhipu
EMBEDDING_MODEL=embedding-3
EMBEDDING_DIM=256
VECTOR_DB_PATH=/app/vector_db
KNOWLEDGE_FILE_PATH=/app/knowledge_files

REDIS_URL=redis://redis:6379/0
REDIS_CONNECT_TIMEOUT=0.3
REDIS_SOCKET_TIMEOUT=0.5
REDIS_RECONNECT_INTERVAL_SECONDS=5

SMS_PROVIDER=console
SMS_EXPOSE_DEV_CODE=1
SMS_CODE_TTL_SECONDS=300
SMS_CODE_SEND_INTERVAL_SECONDS=60
SMS_CODE_PHONE_LIMIT=1
SMS_CODE_PHONE_WINDOW_SECONDS=60
SMS_CODE_IP_LIMIT=20
SMS_CODE_IP_WINDOW_SECONDS=3600
SMS_CODE_DAILY_LIMIT=10
SMS_CODE_DAILY_WINDOW_SECONDS=86400
SMS_CODE_MAX_VERIFY_ATTEMPTS=5

HTTP_CLIENT_MAX_RETRIES=2
HTTP_CLIENT_RETRY_BASE_SECONDS=0.3
HTTP_CIRCUIT_FAILURE_THRESHOLD=5
HTTP_CIRCUIT_COOLDOWN_SECONDS=30
LLM_REQUEST_TIMEOUT_SECONDS=60
LLM_STREAM_TIMEOUT_SECONDS=60
EMBEDDING_REQUEST_TIMEOUT_SECONDS=30

CHAT_RATE_LIMIT=20
CHAT_RATE_WINDOW_SECONDS=60
USER_MAX_CONCURRENT_AGENT_RUNS=2
AGENT_RUN_CONCURRENCY_TTL_SECONDS=300

KNOWLEDGE_UPLOAD_RATE_LIMIT=10
KNOWLEDGE_UPLOAD_RATE_WINDOW_SECONDS=3600
KNOWLEDGE_REINDEX_RATE_LIMIT=10
KNOWLEDGE_REINDEX_RATE_WINDOW_SECONDS=3600
KNOWLEDGE_SEARCH_RATE_LIMIT=30
KNOWLEDGE_SEARCH_RATE_WINDOW_SECONDS=60
KNOWLEDGE_CRAWL_RATE_LIMIT=10
KNOWLEDGE_CRAWL_RATE_WINDOW_SECONDS=3600
CRAWLER_TIMEOUT_SECONDS=10
CRAWLER_MAX_REDIRECTS=5
CRAWLER_MAX_BYTES=2097152
CRAWLER_MIN_TEXT_LENGTH=50
CRAWLER_USER_AGENT=AgentPlatformCrawler/1.0
CRAWLER_ALLOW_PRIVATE_NETWORK=0
CRAWLER_ALLOW_PRIVATE_DNS=0
CRAWLER_BROWSER_FALLBACK=0
CRAWLER_BROWSER_TIMEOUT_SECONDS=20
CRAWLER_BROWSER_WAIT_UNTIL=networkidle
USER_MAX_CONCURRENT_KNOWLEDGE_SEARCHES=3
KNOWLEDGE_SEARCH_CONCURRENCY_TTL_SECONDS=120
USER_MAX_ACTIVE_BACKGROUND_TASKS=5

TASK_EXECUTION_MODE=worker
TASK_WORKER_POLL_SECONDS=2
TASK_RUNNING_TIMEOUT_SECONDS=1800
TASK_MAX_AUTO_RETRIES=2
TASK_RETRY_BASE_SECONDS=30
TASK_RETRY_MAX_SECONDS=300
